# Build-time environment template.
#
# Values live in the deployment platform, not in the repository. Each environment
# (prod, dev, test) sets its own values when it builds. Copy this file to `.env.local`
# only for local development.

# Branding, used by the PWA manifest and the page title.
VITE_DEFAULT_NAME=Jenesei ID
VITE_DEFAULT_NAME_SHORT=Jen. ID
VITE_DEFAULT_THEME_COLOR='#ffffff'
VITE_DEFAULT_DESCRIPTION=The best service to manage your account

# Public base path the application is served from.
VITE_BASE_PATH=/

# API endpoints.
VITE_API_URL=https://id.jenesei.ru
VITE_API_SOCKET_URL=wss://id.api.jenesei.ru

# Cookie domain shared with the core service.
VITE_CORE_URL=.jenesei.ru

# Name of the availability cookie.
VITE_AVAILABILITY_COOKIE_NAME=auth_status

# How long cached query data stays fresh, in seconds.
VITE_QUERY_STALE_TIME=60000

# How long the build info file stays cached, in seconds.
VITE_BUILD_INFO_EXPIRATION_TIME=86400

# Dev server port and build output directory.
VITE_PORT=3000
VITE_OUTPUT_DIR=build

# One of prod | dev | test. Controls robots meta.
VITE_NODE_ENV=prod
